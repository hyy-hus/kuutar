  "query": "\n        SELECT id, collection_id, name, description, allow_recurring, reservable_until, is_public, created_at, updated_at, deleted_at\n        FROM resources\n        WHERE deleted_at IS NULL\n          AND ($1 = TRUE OR is_public = TRUE)\n        ORDER BY name ASC\n        ",
