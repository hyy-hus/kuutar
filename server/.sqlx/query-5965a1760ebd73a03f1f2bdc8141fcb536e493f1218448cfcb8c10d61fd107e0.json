{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            rt.id as token_id, \n            u.id as user_id, \n            u.group_id, \n            u.email, \n            u.password_hash, \n            u.role AS \"role: Role\", \n            rt.expires_at, \n            rt.revoked_at\n        FROM refresh_tokens rt\n        JOIN users u ON u.id = rt.user_id\n        WHERE rt.token_hash = $1 AND u.deleted_at IS NULL\n        ",
