{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            r.id, \n            r.user_id,\n            u.name AS \"user_name?\",\n            u.email AS \"user_email?\",\n            r.title, \n            r.description, \n            r.admin_notes,\n            r.contact_person, \n            r.contact_email, \n            r.contact_phone,\n            r.rrule, \n            r.status AS \"status: ReservationStatus\",\n            r.source,\n            r.contract_id, \n            r.contract_printed_at,\n            r.cancelled_at,\n            r.cancelled_by,\n            r.cancel_reason,\n            r.created_at, \n            r.updated_at\n        FROM reservations r\n        LEFT JOIN users u ON u.id = r.user_id\n        WHERE r.id = $1 AND r.deleted_at IS NULL\n        ",
