{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE resources\n        SET \n            name = COALESCE($1, name),\n            allow_recurring = COALESCE($2, allow_recurring),\n            reservable_until = CASE \n                WHEN $3::timestamptz IS NOT NULL THEN $3\n                ELSE reservable_until \n            END,\n            is_public = COALESCE($4, is_public),\n            updated_at = NOW()\n        WHERE id = $5 AND deleted_at IS NULL\n        RETURNING id, collection_id, name, allow_recurring, reservable_until, is_public, created_at, updated_at, deleted_at\n        ",
