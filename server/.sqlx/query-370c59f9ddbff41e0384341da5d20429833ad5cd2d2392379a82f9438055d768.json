  "query": "\n        UPDATE collections\n        SET\n            name = COALESCE($1, name),\n            description = COALESCE($2, description)\n        WHERE id = $3 AND deleted_at IS NULL\n        RETURNING id, name, description, created_at, updated_at, deleted_at\n        ",
