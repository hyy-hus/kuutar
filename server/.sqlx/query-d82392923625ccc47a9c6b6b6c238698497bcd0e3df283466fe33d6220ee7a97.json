{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT o.id, o.reservation_id, o.resource_id, o.start_time, o.end_time, o.created_at\n            FROM occurrences o\n            JOIN reservations r ON r.id = o.reservation_id\n            WHERE o.resource_id = $1\n              AND r.deleted_at IS NULL\n              AND r.status != 'cancelled'\n              AND o.start_time < $3 \n              AND o.end_time > $2\n            ",
