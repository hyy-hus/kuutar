  "query": "\n        UPDATE resources\n        SET \n            name = COALESCE($1, name),\n            allow_recurring = COALESCE($2, allow_recurring)\n        WHERE id = $3 AND deleted_at IS NULL\n        RETURNING id, collection_id, name, allow_recurring, created_at, updated_at, deleted_at\n        ",
