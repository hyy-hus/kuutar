  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            session_id,\n            session_started_at AS started_at,\n            created_at AS last_active_at,\n            expires_at,\n            user_agent,\n            ip\n        FROM refresh_tokens\n        WHERE user_id = $1 AND revoked_at IS NULL AND expires_at > NOW()\n        ORDER BY created_at DESC\n        ",
