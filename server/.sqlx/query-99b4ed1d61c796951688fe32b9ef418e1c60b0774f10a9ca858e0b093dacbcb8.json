  "query": "\n        SELECT id, reservation_id, resource_id, start_time, end_time, created_at\n        FROM occurrences\n        WHERE reservation_id = $1\n          AND start_time < $3\n          AND end_time > $2\n          AND ($4::uuid IS NULL OR resource_id = $4)\n        ORDER BY start_time ASC\n        ",
