# --- Database ---
# Matches the credentials in the root .env used by docker compose
DATABASE_URL=postgres://kuutar:kuutar@localhost:5432/kuutar
MAX_DB_CONNECTIONS=5

# --- HTTP server ---
BIND_ADDR=127.0.0.1:3000

# --- Authentication ---
# Use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_SECONDS=900

# Admin account created on first start if no admin exists
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=Admin

# --- Email one-time codes via SMTP (optional) ---
# Without SMTP_HOST, sign-in by email code is unavailable; password sign-in still works
# Works with any SMTP server, e.g. Scaleway TEM: smtp.tem.scaleway.com
# (username = project ID, password = API secret key)
# Local development uses Mailpit from compose.yml (inbox: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_TLS: starttls | tls (port 465) | none (local dev only)
SMTP_TLS=none
# Production example (Scaleway TEM): SMTP_HOST=smtp.tem.scaleway.com, SMTP_PORT=587, SMTP_TLS=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_FROM_EMAIL="Kuutar <noreply@kuutar.fi>"

# Public URL of the web app, used for links in emails
APP_BASE_URL=http://localhost:5173

# --- Outlook calendar integration via Microsoft Graph (optional) ---
# Invites sent to the intake mailbox become reservations. The integration is off unless the four
# settings below are all set. Needs an Azure app registration with the Mail.ReadWrite application
# permission, restricted to the intake mailbox.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_INTAKE_MAILBOX=kalenteri@example.com
# GRAPH_POLL_SECONDS=60
# Owner of imported events whose organizer is not a Kuutar user (default: SEED_ADMIN_EMAIL)
# OUTLOOK_FALLBACK_USER_EMAIL=

# --- S3-compatible object storage for contract PDFs ---
# Required to start the server; real credentials are only needed for PDF uploads
S3_BUCKET_NAME=kuutar-contracts
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
AWS_ACCESS_KEY_ID=local-placeholder
AWS_SECRET_ACCESS_KEY=local-placeholder
